    {
      "name": "Employees",
      "item": [
        {
          "name": "Get Employees by Department (Query Parameter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns array of employees', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "    pm.expect(jsonData.count).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Employee data format matches Helpdesk requirements', function () {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.data.length > 0) {",
                  "        const employee = jsonData.data[0];",
                  "        pm.expect(employee).to.have.property('userId');",
                  "        pm.expect(employee).to.have.property('name');",
                  "        pm.expect(employee).to.have.property('email');",
                  "        pm.expect(employee).to.have.property('departmentId');",
                  "        pm.expect(employee).to.have.property('role');",
                  "        pm.expect(employee).to.have.property('status');",
                  "        pm.expect(employee.status).to.be.oneOf(['active', 'inactive']);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/employees?departmentId={{departmentId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "employees"],
              "query": [
                {
                  "key": "departmentId",
                  "value": "{{departmentId}}"
                }
              ]
            }
          }
        },
