            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test.employee@hrsystem.gov\",\n  \"password\": \"Test123!\",\n  \"role\": \"EMPLOYEE\",\n  \"fullName\": \"Test Employee\",\n  \"phone\": \"+1234567899\",\n  \"departmentId\": \"{{departmentId}}\",\n  \"position\": \"Test Position\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
