                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.employee).to.exist;",
                  "    pm.expect(jsonData.data.employee.employeeCode).to.exist;",
                  "    pm.expect(jsonData.data.employee.status).to.equal('ACTIVE');",
                  "});"
