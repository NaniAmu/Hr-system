    {
      "name": "Tests - Auto Employee Creation",
      "item": [
        {
          "name": "Test: Register User Auto-Creates Employee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User registration auto-creates Employee', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.employee).to.exist;",
                  "    pm.expect(jsonData.data.employee.employeeCode).to.exist;",
                  "    pm.expect(jsonData.data.employee.id).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
