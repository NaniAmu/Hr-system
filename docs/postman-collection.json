      "item": [
        {
          "name": "Register Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('User and Employee created automatically', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.user).to.exist;",
                  "    pm.expect(jsonData.data.employee).to.exist;",
                  "    pm.expect(jsonData.data.employee.employeeCode).to.exist;",
                  "    pm.expect(jsonData.data.token).to.exist;",
                  "    pm.collectionVariables.set('adminToken', jsonData.data.token);",
                  "    pm.collectionVariables.set('userId', jsonData.data.user.id);",
                  "    pm.collectionVariables.set('employeeId', jsonData.data.employee.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@hrsystem.gov\",\n  \"password\": \"Admin123!\",\n  \"role\": \"ADMIN\",\n  \"fullName\": \"System Administrator\",\n  \"phone\": \"+1234567890\",\n  \"departmentId\": \"{{departmentId}}\",\n  \"position\": \"System Administrator\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
